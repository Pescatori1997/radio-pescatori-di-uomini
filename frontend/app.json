{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.evangelicstream.wwoeys",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSPhotoLibraryUsageDescription": "Carica la tua foto ritratto per candidarti all'Equipaggio",
        "NSPhotoLibraryAddUsageDescription": "Salva le card da condividere nella tua galleria",
        "NSLocationWhenInUseUsageDescription": "Mostra il meteo della tua zona"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.evangelicstream.wwoeys",
      "permissions": [
        "FOREGROUND_SERVICE",
        "WAKE_LOCK",
        "READ_MEDIA_IMAGES",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-audio",
      [
        "expo-media-library",
        {
          "photosPermission": "Salva le card da condividere nella tua galleria.",
          "savePhotosPermission": "Salva le card da condividere nella tua galleria.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo.png",
          "color": "#0A1128"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}